# OpenWeatherMap API key (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Enable fabricated sample weather only for local demos; never enable in production.
WEATHER_DEMO_MODE=false

# Backend port
PORT=5000

# Cache TTL in seconds
CACHE_TTL_SECONDS=600

# CORS origin: * or a comma-separated list of exact frontend origins
# Example: https://weather.example.com,http://localhost:5173
CORS_ORIGIN=*

# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=8000
